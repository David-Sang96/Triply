# Auth — Clerk (Google sign-in only)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated browser origins allowed to mint tokens this API accepts
# (Clerk's authorizedParties), e.g. "https://triply-app.expo.app".
# Optional in local development — leave blank and verifyToken skips the check.
# REQUIRED in production: the server refuses to start (NODE_ENV=production)
# without this set, since an unset value there would silently accept tokens
# from any Clerk-connected frontend. Override this with the real deployed
# origin(s) in your production environment config — do not carry the local
# blank default into production.
#
# Only checked for requests that send an `Origin` header, i.e. browsers. The
# app itself is native, has no origin, and so mints tokens with no `azp` claim
# — and Clerk rejects a missing claim rather than skipping the check. Listing
# the app scheme here does not help: it is never what `azp` contains. See the
# long note in src/server/auth.ts.
CLERK_AUTHORIZED_PARTIES=

# Database — Neon (use the HTTP connection string)
#
# TWO databases, one Neon project with two branches:
#   .env             -> the `dev` branch. Everyday work goes here. Use this
#                       file, not `.env.local`: the db:* scripts and
#                       drizzle.config.ts run as plain Node and read `.env`.
#   .env.production  -> the `production` branch. Create this file yourself (it
#                       is gitignored by the `.env.*` rule). It needs
#                       DATABASE_URL **and** CLERK_SECRET_KEY — the `:prod`
#                       scripts load only this file, so anything absent here is
#                       simply unset. Both must be the production values: a
#                       test CLERK_SECRET_KEY next to the production database
#                       makes every user look missing from Clerk.
#
# The db:* scripts default to .env. The `:prod` variants — db:migrate:prod,
# db:check:prod, db:studio:prod — read .env.production instead. The unsafe
# target is the one you have to name.
DATABASE_URL=

# AI — Google Gemini (Google AI Studio free key)
GEMINI_API_KEY=

# Images — Unsplash (search; hotlinked + attributed per their API terms) + ImageKit (optimization/transform)
#
# Only these two are read by code. ImageKit's public key and URL endpoint used
# to be listed here and never referenced anywhere, and Unsplash's secret key is
# not needed for the search API — an unused secret in an env file is one more
# thing to rotate and leak, so they are gone rather than blank.
UNSPLASH_ACCESS_KEY=
IMAGEKIT_PRIVATE_KEY=

# Place verification — Photon geocoder (OSM-based, no key/card needed).
# This contact string is OPTIONAL now (sent as a courtesy). e.g. "Triply/1.0 (you@email.com)"
NOMINATIM_USER_AGENT=

# Map tiles — MapTiler (free tier: ~100k tile requests/month, no card)
#
# REQUIRED for any build that real users touch. Leave it blank and the map
# falls back to OpenStreetMap's public tile server, which is licensed for light
# and personal use only — fine while developing, not allowed in production.
#
# EXPO_PUBLIC_ means this key is bundled into the app and readable by anyone who
# unpacks it. That is unavoidable for a client-rendered map (see the note in
# src/components/trip/TripMap.tsx). If the quota is ever burned by someone else,
# rotate the key in the MapTiler dashboard and ship it with `eas update` — it is
# read at build time, so it also has to be set in EAS, not only here.
EXPO_PUBLIC_MAPTILER_KEY=

# Background jobs — Inngest
INNGEST_DEV=1
# only needed in production - you can ignore these in development
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# Monitoring — Sentry (DSN is safe to expose in the client app)
EXPO_PUBLIC_SENTRY_DSN=

# API base URL for the app to reach its own Expo Router API routes.
# Leave BLANK in development — the app auto-targets the Metro dev server.
# In production set this to the deployed EAS Hosting origin, e.g. https://triply.expo.app
# EXPO_PUBLIC_API_URL=
