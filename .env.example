# Auth — Clerk (Google sign-in only)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Database — Neon (use the HTTP connection string)
DATABASE_URL=

# AI — Google Gemini (Google AI Studio free key)
GEMINI_API_KEY=

# Images — Pexels (search) + ImageKit (optimization/transform)
PEXELS_API_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Place verification — OpenStreetMap Nominatim (required contact string, e.g. "Triply/1.0 (you@email.com)")
NOMINATIM_USER_AGENT=

# Background jobs — Inngest
INNGEST_DEV=1
# only needed in production - you can ignore these in development
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# Monitoring — Sentry (DSN is safe to expose in the client app)
EXPO_PUBLIC_SENTRY_DSN=
