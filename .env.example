# Auth — Clerk (Google sign-in only)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional: comma-separated origins/app schemes allowed to mint tokens this API
# accepts (Clerk's authorizedParties), e.g. "https://triply.expo.app,triply://".
# Leave blank until the deployed origin is known — verifyToken skips the check
# when unset.
CLERK_AUTHORIZED_PARTIES=

# Database — Neon (use the HTTP connection string)
DATABASE_URL=

# AI — Google Gemini (Google AI Studio free key)
GEMINI_API_KEY=

# Images — Unsplash (search; hotlinked + attributed per their API terms) + ImageKit (optimization/transform)
UNSPLASH_ACCESS_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Place verification — Photon geocoder (OSM-based, no key/card needed).
# This contact string is OPTIONAL now (sent as a courtesy). e.g. "Triply/1.0 (you@email.com)"
NOMINATIM_USER_AGENT=

# Background jobs — Inngest
INNGEST_DEV=1
# only needed in production - you can ignore these in development
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# Monitoring — Sentry (DSN is safe to expose in the client app)
EXPO_PUBLIC_SENTRY_DSN=

# API base URL for the app to reach its own Expo Router API routes.
# Leave BLANK in development — the app auto-targets the Metro dev server.
# In production set this to the deployed EAS Hosting origin, e.g. https://triply.expo.app
# EXPO_PUBLIC_API_URL=
