{
  "expo": {
    "name": "TRIPLY",
    "slug": "TRIPLY",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "triply",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/1ddecbb5-873f-428d-aaee-876b282fee92"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.davidsang.triply"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D9E7FB"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "qworky",
          "project": "triply-tutorial",
          "url": "https://sentry.io/"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Triply to access your photos so you can set a custom trip cover."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ddecbb5-873f-428d-aaee-876b282fee92"
      }
    },
    "owner": "david_sang"
  }
}
